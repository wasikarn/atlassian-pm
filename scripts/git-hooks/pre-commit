#!/usr/bin/env bash
# pre-commit: sensitive data check + markdown lint + QA gates
# Install: bash scripts/install-hooks.sh

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── 1. sensitive data check (staged content only) ────────────────────────────
SENSITIVE_PATTERNS=(
    "100-stars\.atlassian\.net"
    "@tathep\.com"
    "@100stars\.com"
    "bluedragon\.space"
    "bluedragoneyes\.ai"
    "bluedragonvision\.com"
    "app\.tathep\.com"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v "configure_project.py" || true)

if [ -n "$STAGED_FILES" ]; then
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        FAILED_FILES=""
        for file in $STAGED_FILES; do
            if git show ":$file" 2>/dev/null | grep -qE "$pattern"; then
                FAILED_FILES="$FAILED_FILES $file"
            fi
        done
        if [ -n "$FAILED_FILES" ]; then
            echo "Sensitive data detected in staged content: $pattern"
            echo "  Files:$FAILED_FILES"
            echo ""
            echo "Fix: Clean filter may not be configured. Run: ./scripts/setup.sh"
            exit 1
        fi
    done
fi

# ── 2. markdown auto-fix (staged .md files only) ──────────────────────────────
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$STAGED_MD" ]; then
    echo "Running markdownlint on staged .md files..."
    FILES_WITH_UNSTAGED=$(git diff --name-only || true)

    echo "$STAGED_MD" | xargs npx markdownlint-cli2 --fix 2>/dev/null || true

    for FILE in $STAGED_MD; do
        if echo "$FILES_WITH_UNSTAGED" | grep -qx "$FILE"; then
            git diff -- "$FILE" | git apply --cached --whitespace=nowarn 2>/dev/null || git add "$FILE"
        else
            git add "$FILE"
        fi
    done
    echo "Markdown lint complete"
fi

# ── 3. QA gates (mirrors GitHub Actions) ─────────────────────────────────────
echo ""
bash "$REPO_ROOT/scripts/qa-check.sh"
