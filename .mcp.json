{
  "mcpServers": {
    "atlassian-cache": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/atlassian-cache",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/atlassian-cache/server.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/scripts",
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}