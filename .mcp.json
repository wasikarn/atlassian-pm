{
  "mcpServers": {
    "atlassian-cache": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "mcp-servers/atlassian-cache",
        "mcp-servers/atlassian-cache/server.py"
      ],
      "cwd": "${HOME}/.claude/plugins/marketplaces/atlassian-pm",
      "env": {
        "PYTHONPATH": "${HOME}/.claude/plugins/marketplaces/atlassian-pm/scripts",
        "UV_PROJECT_ENVIRONMENT": "${HOME}/.claude/plugins/data/atlassian-pm-atlassian-pm/venv",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
